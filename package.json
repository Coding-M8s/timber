{
  "name": "timber",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": { "timber": "./src/index.ts" },
  "packageManager": "bun@1.4.5",
  "engines": { "bun": ">=1.4.5" },
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test --parallel --timeout=30000 --timings tests/timings.json",
    "test:serial": "bun test --timeout=30000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p vscode-extension",
    "check:attribution": "bun --no-env-file scripts/check-commit-attribution.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "build:release": "bun --no-env-file scripts/release.ts",
    "build:extension": "bun build vscode-extension/src/extension.ts --target=node --format=cjs --external vscode --outfile vscode-extension/dist/extension.js",
    "package:extension": "bun run build:extension && cd vscode-extension && bunx @vscode/vsce@4.1.0 package --no-dependencies"
  },
  "dependencies": {
    "commander": "15.0.0",
    "execa": "10.1.0",
    "fuzzysort": "4.0.2",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/vscode": "1.146.0",
    "typescript": "7.0.2"
  }
}
