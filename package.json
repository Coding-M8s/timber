{
  "name": "timber",
  "version": "0.1.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": { "timber": "./src/index.ts" },
  "packageManager": "bun@1.4.4",
  "engines": { "bun": ">=1.4.4" },
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test --parallel --timeout=30000",
    "test:serial": "bun test --timeout=30000",
    "typecheck": "tsc --noEmit",
    "check:attribution": "bun --no-env-file scripts/check-commit-attribution.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "build:release": "bun --no-env-file scripts/release.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "execa": "10.1.0",
    "fuzzysort": "4.0.2",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
